@* Which warehouse serves each governorate: governorates take the colour of their warehouse, uncovered ones stay grey.
   With OnPick the map becomes a location picker (click to drop the pin); with OnToggle a click toggles coverage. *@
@inject IJSRuntime JS

<svg @ref="svg" class="@Bp.Cls("lx-map", "lx-coverage-map", Bp.When(OnPick.HasDelegate, "lx-map-picking"))" viewBox="@ViewBox" role="img"
     aria-label="@L["CoverageMap"]" xmlns="http://www.w3.org/2000/svg" @onclick="ClickAsync">
    <g>
        @foreach (var shape in IraqMapShapes.Governorates)
        {
            var owner = OwnerOf(shape.Code);
            var name = IraqGovernorates.Find(shape.Code)?.Name ?? shape.Code;
            var mine = Editing is not null && owner?.Code == Editing;
            <path d="@shape.Path" fill="@(owner is null ? null : ColorOf(owner.Code, mine ? 0.85 : Editing is null ? 0.55 : 0.28))"
                  class="@Bp.Cls("lx-map-gov", Bp.When(owner is null, "lx-map-s0"), Bp.When(mine, "lx-map-gov-selected"))" @onclick="@(() => clicked = shape.Code)">
                <title>@name · @(owner?.DisplayLabel ?? L["NotCovered"].Value)</title>
            </path>
        }
    </g>

    @if (!Compact)
    {
        <g>
            @foreach (var shape in IraqMapShapes.Governorates)
            {
                var (x, y) = IraqMap.LabelAt(shape);
                @SvgText(x, y, "lx-map-label", IraqGovernorates.Find(shape.Code)?.Name ?? shape.Code)
            }
        </g>
    }

    <g>
        @foreach (var hub in Hubs.Where(h => h.Latitude > 0 && h.Code != Editing))
        {
            var (x, y) = IraqMapShapes.Project(hub.Latitude, hub.Longitude);
            <circle cx="@F(x)" cy="@F(y)" r="@(hub.Kind == HubKind.SortingHub ? "12" : "9")" fill="@ColorOf(hub.Code, 1)" class="lx-map-hub-plain" />
            @SvgText(x, y + 3.2, "lx-map-hub-text", hub.RoutingTag)
        }
        @if (Pin is { } pin)
        {
            var (x, y) = IraqMapShapes.Project(pin.Latitude, pin.Longitude);
            <g class="lx-map-pin" transform="@($"translate({F(x)},{F(y)})")">
                <path d="M0,0 C-9,-12 -12,-17 -12,-23 A12,12 0 1 1 12,-23 C12,-17 9,-12 0,0 Z" />
                <circle cx="0" cy="-23" r="5" fill="#fff" />
            </g>
        }
    </g>
</svg>

@if (!Compact)
{
    <div class="lx-map-legend lx-coverage-legend">
        @foreach (var hub in Hubs)
        {
            <span class="lx-row" style="gap:6px"><span class="lx-swatch" style="background:@ColorOf(hub.Code, 1)"></span><bdi>@hub.RoutingTag</bdi> @hub.Name</span>
        }
        <span class="lx-row" style="gap:6px"><span class="lx-swatch" style="background:var(--lx-map-0);box-shadow:inset 0 0 0 1px var(--lx-border-strong)"></span>@L["NotCovered"]</span>
    </div>
}

@code {
    // Distinct, colour-blind-friendly hues (Blueprint's extended palette).
    private static readonly string[] Hues = ["#2d72d2", "#c87619", "#238551", "#7961db", "#cd4246", "#00a396", "#d1980b", "#d13913", "#634dbf", "#147eb3"];

    private ElementReference svg;
    private string? clicked;

    /// <summary>Every warehouse to draw (the one being edited included, with its live coverage).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<HubInfo> Hubs { get; set; } = [];

    /// <summary>Code of the warehouse being edited: its governorates are highlighted, the others faded.</summary>
    [Parameter] public string? Editing { get; set; }

    [Parameter] public (double Latitude, double Longitude)? Pin { get; set; }

    /// <summary>Click on the map: position in degrees and the governorate under the pointer.</summary>
    [Parameter] public EventCallback<(double Latitude, double Longitude, string? Governorate)> OnPick { get; set; }

    [Parameter] public bool Compact { get; set; }

    private static string ViewBox => string.Create(CultureInfo.InvariantCulture, $"0 0 {IraqMapShapes.Width} {IraqMapShapes.Height}");

    private HubInfo? OwnerOf(string governorate)
    {
        // Halabja has no outline of its own; it is drawn within Sulaymaniyah.
        var owner = Hubs.FirstOrDefault(h => h.Covers.Contains(governorate, StringComparer.OrdinalIgnoreCase));
        return owner;
    }

    private string ColorOf(string hubCode, double alpha)
    {
        var index = Math.Max(0, Hubs.Select(h => h.Code).ToList().IndexOf(hubCode));
        var hex = Hues[index % Hues.Length];
        if (alpha >= 1)
        {
            return hex;
        }

        var r = Convert.ToInt32(hex[1..3], 16);
        var g = Convert.ToInt32(hex[3..5], 16);
        var b = Convert.ToInt32(hex[5..7], 16);
        return string.Create(CultureInfo.InvariantCulture, $"rgba({r},{g},{b},{alpha:0.##})");
    }

    private async Task ClickAsync(MouseEventArgs e)
    {
        var governorate = clicked;
        clicked = null;
        if (!OnPick.HasDelegate)
        {
            return;
        }

        var point = await JS.InvokeAsync<double[]?>("lx.svgPoint", svg, e.ClientX, e.ClientY);
        if (point is [var x, var y])
        {
            var (lat, lon) = IraqMapShapes.Unproject(x, y);
            await OnPick.InvokeAsync((Math.Round(lat, 5), Math.Round(lon, 5), governorate));
        }
    }

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static MarkupString SvgText(double x, double y, string cssClass, string content) =>
        new($"<text x=\"{F(x)}\" y=\"{F(y)}\" class=\"{cssClass}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");
}
