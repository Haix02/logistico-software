@* Weekday × hour heat grid (Baghdad time). Rows run Sunday → Saturday as the Iraqi week; hours follow the reading
   direction, so they mirror in Arabic. Each cell is shaded in seven steps relative to the busiest hour. *@

<div class="lx-heat" role="table" aria-label="@AriaLabel">
    <div class="lx-heat-row lx-heat-head" role="row">
        <span class="lx-heat-day" role="columnheader"></span>
        @for (var hour = 0; hour < 24; hour++)
        {
            <span class="lx-heat-hour" role="columnheader">@(hour % 3 == 0 ? hour.ToString("00", CultureInfo.InvariantCulture) : "")</span>
        }
    </div>
    @for (var day = 0; day < 7; day++)
    {
        var format = CultureInfo.CurrentCulture.DateTimeFormat;
        var fullName = format.GetDayName((DayOfWeek)day);
        <div class="lx-heat-row" role="row">
            @* Arabic "abbreviated" day names are the full words, so phones show the one-letter form. *@
            <span class="lx-heat-day" role="rowheader" title="@fullName"><span class="lx-heat-day-long">@format.GetAbbreviatedDayName((DayOfWeek)day)</span><span class="lx-heat-day-short" aria-hidden="true">@format.GetShortestDayName((DayOfWeek)day)</span></span>
            @for (var hour = 0; hour < 24; hour++)
            {
                var count = ValueAt(day, hour);
                var tip = $"{fullName} {hour:00}:00–{(hour + 1) % 24:00}:00 · {L.Count("OrdersN", count)}";
                <span class="@Bp.Cls("lx-heat-cell", "lx-heat-" + Step(count).ToString(CultureInfo.InvariantCulture), Bp.When(day == Peak.Day && hour == Peak.Hour && count > 0, "lx-heat-peak"))"
                      role="cell" title="@tip" aria-label="@tip"></span>
            }
        </div>
    }
    <div class="lx-heat-legend">
        <span>@L["Map_Low"]</span>
        @for (var step = 0; step < 7; step++)
        {
            <span class="@($"lx-heat-cell lx-heat-{step}")" aria-hidden="true"></span>
        }
        <span>@L["Map_High"]</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<OrderTimeCell> Cells { get; set; } = [];
    [Parameter] public string? AriaLabel { get; set; }

    private Dictionary<(int Day, int Hour), int> byCell = [];
    private int max = 1;

    private (int Day, int Hour) Peak { get; set; }

    protected override void OnParametersSet()
    {
        byCell = Cells.ToDictionary(c => (c.Day, c.Hour), c => c.Orders);
        max = Math.Max(1, Cells.Count == 0 ? 0 : Cells.Max(c => c.Orders));
        Peak = Cells.Count == 0 ? (-1, -1) : Cells.OrderByDescending(c => c.Orders).Select(c => (c.Day, c.Hour)).First();
    }

    private int ValueAt(int day, int hour) => byCell.GetValueOrDefault((day, hour));

    private int Step(int count) => count <= 0 ? 0 : Math.Clamp((int)Math.Ceiling(count * 6.0 / max), 1, 6);
}
