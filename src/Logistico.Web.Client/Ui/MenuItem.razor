@* One row of a Blueprint menu (bp6-menu). Closes the surrounding popover after it is chosen. *@
<li role="none">
    @if (Href is not null && !Disabled)
    {
        <a class="@ItemClass" href="@Href" role="menuitem" target="@Target" @onclick="CloseParentAsync">@Body</a>
    }
    else
    {
        <a class="@ItemClass" role="menuitem" tabindex="@(Disabled ? -1 : 0)" aria-disabled="@(Disabled ? "true" : null)"
           @onclick="ClickAsync" @onkeydown="KeyAsync">@Body</a>
    }
</li>

@code {
    [CascadingParameter] public Popover? Popover { get; set; }

    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public Intent Intent { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shows a tick when true (check-style menus).</summary>
    [Parameter] public bool? Selected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ItemClass => Bp.Cls("bp6-menu-item", Bp.IntentClass(Intent), Bp.When(Active, "bp6-active"), Bp.When(Disabled, "bp6-disabled"));

    private RenderFragment Body => @<text>
        @if (Selected is not null)
        {
            <Icon Name="@(Selected.Value ? "tick" : "blank")" />
        }
        else if (Icon is not null)
        {
            <Icon Name="@Icon" />
        }
        <span class="bp6-text-overflow-ellipsis bp6-fill">@Text@ChildContent</span>
        @if (Label is not null)
        {
            <span class="bp6-menu-item-label">@Label</span>
        }
    </text>;

    private async Task ClickAsync()
    {
        if (Disabled)
        {
            return;
        }

        await OnClick.InvokeAsync();
        await CloseParentAsync();
    }

    private Task KeyAsync(KeyboardEventArgs e) => e.Key is "Enter" or " " ? ClickAsync() : Task.CompletedTask;

    private Task CloseParentAsync() => Popover?.CloseAsync() ?? Task.CompletedTask;
}
