@page "/finance"
@attribute [Authorize(Policy = StaffPolicies.Finance)]
@inject ShipmentsApi Shipments
@inject NavigationManager Navigation
@inject Toaster Toaster

<PageTitle>@L["Nav_Finance"] · @L["AppName"]</PageTitle>

<PageHeader Title="@L["FinanceTitle"]" Subtitle="@L["FinanceSubtitle"]" Icon="bank-account">
    <Actions>
        <Button Icon="refresh" Minimal="true" Title="@L["Refresh"]" OnClick="LoadAsync" />
    </Actions>
</PageHeader>

@if (summary is null)
{
    <div class="lx-center lx-pad"><Spinner /></div>
}
else
{
    <div class="lx-kpis">
        <KpiCard Icon="truck" Label="@L["Kpi_PendingCodCollection"]" Amount="summary.PendingCodToCollectIqd" />
        <KpiCard Icon="people" Label="@L["Kpi_CodWithCouriers"]" Amount="summary.CodWithCouriersIqd" Hint="@L["Kpi_CodWithCouriersHint"]" Href="fleet" />
        <KpiCard Icon="dollar" Label="@L["Kpi_UnsettledCod"]" Amount="summary.UnsettledCodCollectedIqd" Intent="Intent.Primary" />
        <KpiCard Icon="bank-account" Label="@L["Kpi_NetPayableToSellers"]" Amount="summary.UnsettledNetPayableIqd" Intent="Intent.Warning" />
        <KpiCard Icon="tick-circle" Label="@L["Kpi_TotalSettled"]" Amount="summary.TotalSettledNetPaidIqd" Intent="Intent.Success" />
        <KpiCard Icon="chart" Label="@L["Kpi_DeliveryRevenue"]" Amount="summary.TotalDeliveryRevenueIqd" />
    </div>

    <Section Title="@L["SellerBalancesTitle"]" Subtitle="@L["SellerBalancesSubtitle"]" Icon="shop" Padded="false">
        <DataTable TItem="SellerCodBalance" Items="summary.SellerBalances" ColumnCount="7" EmptyIcon="tick-circle" EmptyTitle="@L["NoUnsettledBalances"]">
            <Header>
                <th>@L["Col_Seller"]</th>
                <th class="lx-num">@L["Col_DeliveredUnsettled"]</th>
                <th class="lx-num">@L["Col_GrossCod"]</th>
                <th class="lx-num">@L["Col_DeliveryFees"]</th>
                <th class="lx-num">@L["Col_NetPayout"]</th>
                <th class="lx-num">@L["Col_InProgressCod"]</th>
                <th>@L["Col_Action"]</th>
            </Header>
            <Row Context="b">
                <td><a class="lx-strong" href="@($"merchants/{b.MerchantId}")">@b.MerchantName</a></td>
                <td class="lx-num">@Fmt.Number(b.DeliveredUnsettledCount)</td>
                <td class="lx-num">@Fmt.Money(b.GrossCodIqd, "IQD")</td>
                <td class="lx-num bp6-text-muted">@Fmt.Money(b.DeliveryFeesIqd, "IQD")</td>
                <td class="lx-num lx-strong">@Fmt.Money(b.NetPayableIqd, "IQD")</td>
                <td class="lx-num bp6-text-muted">@Fmt.Money(b.InProgressCodIqd, "IQD") (@Fmt.Number(b.InProgressCount))</td>
                <td>
                    @if (b.DeliveredUnsettledCount > 0)
                    {
                        <Allowed Policy="@StaffPolicies.Finance">
                            <Button Small="true" Icon="bank-account" Text="@L["SettlePayout"]" OnClick="@(() => OpenSettle(b))" />
                        </Allowed>
                    }
                    @if (b.WithCouriersCount > 0)
                    {
                        @* Paid out only once the couriers hand the cash in (Fleet page). *@
                        <a href="fleet"><Tag Minimal="true" Icon="people" Title="@Fmt.Money(b.WithCouriersIqd, "IQD")">@L.Count("WithCouriersN", b.WithCouriersCount)</Tag></a>
                    }
                </td>
            </Row>
        </DataTable>
    </Section>

    <Section Title="@L["SettlementsHistoryTitle"]" Subtitle="@L["SettlementsHistorySubtitle"]" Icon="history" Padded="false">
        <DataTable TItem="CodSettlementItem" Items="summary.RecentSettlements" ColumnCount="9" EmptyIcon="bank-account" EmptyTitle="@L["NoSettlementsYet"]">
            <Header>
                <th>@L["Col_SettlementNo"]</th>
                <th>@L["Col_Seller"]</th>
                <th class="lx-num">@L["Field_Pieces"]</th>
                <th class="lx-num">@L["Col_GrossCod"]</th>
                <th class="lx-num">@L["Col_DeliveryFees"]</th>
                <th class="lx-num">@L["Col_NetPayout"]</th>
                <th>@L["Col_PayoutMethod"]</th>
                <th>@L["Col_SettledAt"]</th>
                <th>@L["Col_Action"]</th>
            </Header>
            <Row Context="s">
                <td class="lx-code lx-nowrap" dir="ltr">@s.SettlementNumber</td>
                <td><a href="@($"merchants/{s.MerchantId}")">@s.MerchantName</a></td>
                <td class="lx-num">@Fmt.Number(s.ShipmentCount)</td>
                <td class="lx-num">@Fmt.Money(s.GrossCodAmount, s.Currency)</td>
                <td class="lx-num bp6-text-muted">@Fmt.Money(s.DeliveryFeesAmount, s.Currency)</td>
                <td class="lx-num lx-strong">@Fmt.Money(s.NetPayoutAmount, s.Currency)</td>
                <td>
                    <Tag Intent="Intent.Success">@ShipmentTexts.Of(s.PayoutMethod)</Tag>
                    @if (!string.IsNullOrWhiteSpace(s.PayoutReference))
                    {
                        <div class="bp6-text-muted lx-small lx-mono" dir="ltr">@s.PayoutReference</div>
                    }
                </td>
                <td class="bp6-text-muted lx-nowrap">@Fmt.DateTime(s.SettledAt)</td>
                <td>
                    <Allowed Policy="@StaffPolicies.Finance">
                        <LinkButton Href="@Shipments.SettlementExportUrl(s.Id)" Target="_blank" Small="true" Minimal="true" Icon="download" Text="@L["DownloadStatement"]" CssClass="lx-nowrap" />
                    </Allowed>
                </td>
            </Row>
        </DataTable>
    </Section>
}

<Dialog @bind-IsOpen="dialogOpen" Title="@(selectedSeller is null ? L["SettlePayout"].Value : string.Format(CultureInfo.CurrentCulture, L["SettleDialogTitle"], selectedSeller.MerchantName))" Icon="bank-account" Width="620px">
    <ChildContent>
        @if (selectedSeller is not null)
        {
            <div class="bp6-card lx-mb">
                <dl class="lx-props">
                    <dt>@L["Col_DeliveredUnsettled"]</dt>
                    <dd>@Fmt.Number(selectedSeller.DeliveredUnsettledCount)</dd>
                    <dt>@L["Col_GrossCod"]</dt>
                    <dd>@Fmt.Money(selectedSeller.GrossCodIqd, "IQD")</dd>
                    <dt>@L["Col_DeliveryFees"]</dt>
                    <dd>@Fmt.Money(selectedSeller.DeliveryFeesIqd, "IQD")</dd>
                    <dt>@L["Col_NetPayout"]</dt>
                    <dd class="lx-strong">@Fmt.Money(selectedSeller.NetPayableIqd, "IQD")</dd>
                </dl>
            </div>
            <EditForm Model="draft" OnValidSubmit="ConfirmSettlementAsync" id="settle-form">
                <DataAnnotationsValidator />
                <div class="lx-form-grid">
                    <FormField Label="@L["Field_PayoutMethod"]" Field="() => draft.PayoutMethod">
                        <span class="bp6-html-select bp6-fill">
                            <InputSelect @bind-Value="draft.PayoutMethod">
                                @foreach (var m in Enum.GetValues<PayoutMethod>())
                                {
                                    <option value="@m">@ShipmentTexts.Of(m)</option>
                                }
                            </InputSelect>
                            <span class="bp6-icon bp6-icon-standard bp6-icon-double-caret-vertical"></span>
                        </span>
                    </FormField>
                    <FormField Label="@L["Field_PayoutRef"]" Hint="@L["Optional"]" Field="() => draft.PayoutReference">
                        <InputText class="bp6-input bp6-fill lx-mono" @bind-Value="draft.PayoutReference" dir="ltr" placeholder="ZC-2026-99102" />
                    </FormField>
                    <FormField Label="@L["Field_Notes"]" Hint="@L["Optional"]" Field="() => draft.Notes" CssClass="lx-span-2">
                        <InputText class="bp6-input bp6-fill" @bind-Value="draft.Notes" />
                    </FormField>
                </div>
                @if (error is not null)
                {
                    <Callout Intent="Intent.Danger" Icon="error" CssClass="lx-mt">@error</Callout>
                }
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <Button Text="@L["Cancel"]" OnClick="@(() => dialogOpen = false)" />
        <Button Type="submit" form="settle-form" Intent="Intent.Primary" Icon="tick" Text="@L["ConfirmSettlement"]" Loading="saving" />
    </Footer>
</Dialog>

@code {
    private FinanceSummary? summary;
    private SellerCodBalance? selectedSeller;
    private CreateCodSettlementRequest draft = new();
    private bool dialogOpen;
    private bool saving;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => summary = await Shipments.GetFinanceSummaryAsync();

    private void OpenSettle(SellerCodBalance balance)
    {
        selectedSeller = balance;
        draft = new CreateCodSettlementRequest
        {
            MerchantId = balance.MerchantId,
            PayoutMethod = PayoutMethod.ZainCash,
        };
        error = null;
        dialogOpen = true;
    }

    private async Task ConfirmSettlementAsync()
    {
        saving = true;
        error = null;
        try
        {
            var created = await Shipments.CreateSettlementAsync(draft);
            dialogOpen = false;
            Toaster.Success(string.Format(CultureInfo.CurrentCulture, L["SettlementCreated"], created.SettlementNumber, Fmt.Money(created.NetPayoutAmount, created.Currency)));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            error = ex.UserMessage;
        }
        finally
        {
            saving = false;
        }
    }
}

