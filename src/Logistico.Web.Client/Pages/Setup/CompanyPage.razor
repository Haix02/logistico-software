@page "/settings/company"
@attribute [Authorize(Policy = StaffPolicies.Administer)]
@inject CompanyApi Company
@inject Toaster Toaster

<PageTitle>@L["Nav_Company"] · @L["AppName"]</PageTitle>

<PageHeader Title="@L["Nav_Company"]" Subtitle="@L["Company_Subtitle"]" Icon="office" />

@if (view is null)
{
    <Skeleton Block="true" Lines="5" />
}
else
{
    <Section Title="@L["Company_Profile"]" Subtitle="@L["Company_ProfileHint"]" Icon="office">
        <EditForm Model="model" OnValidSubmit="SaveAsync" Context="form">
            <DataAnnotationsValidator />
            <ServerErrors @ref="serverErrors" />
            <div class="lx-form-grid">
                <FormField Label="@L["Company_Name"]" Required="true" Field="() => model.Name" CssClass="lx-span-2">
                    <InputText class="bp6-input bp6-fill" @bind-Value="model.Name" dir="auto" maxlength="100" />
                </FormField>
                <FormField Label="@L["Field_Phone"]" Field="() => model.Phone">
                    <InputText class="bp6-input bp6-fill" @bind-Value="model.Phone" type="tel" dir="ltr" maxlength="20" placeholder="0770 123 4567" />
                </FormField>
                <FormField TValue="string" Label="@L["Company_Governorate"]" Hint="@L["Optional"]" For="lx-company-gov">
                    <HtmlSelect Id="lx-company-gov" Value="@model.Governorate" ValueChanged="@(v => model.Governorate = string.IsNullOrEmpty(v) ? null : v)" Fill="true" Label="@L["Company_Governorate"]">
                        <option value="">—</option>
                        @foreach (var g in IraqGovernorates.All.OrderBy(g => g.Name, StringComparer.CurrentCulture))
                        {
                            <option value="@g.Code">@g.Name</option>
                        }
                    </HtmlSelect>
                </FormField>
                <FormField Label="@L["Field_Address"]" Hint="@L["Optional"]" Field="() => model.Address" CssClass="lx-span-2">
                    <InputTextArea class="bp6-input bp6-fill" rows="2" @bind-Value="model.Address" dir="auto" maxlength="300" />
                </FormField>
            </div>
            @if (error is not null)
            {
                <Callout Intent="Intent.Danger" Icon="error" CssClass="lx-mb">@error</Callout>
            }
            <div class="lx-row" style="gap:12px">
                <Button Type="submit" Intent="Intent.Primary" Icon="tick" Text="@L["Save"]" Loading="saving" />
                @if (view.UpdatedAt is { } at)
                {
                    <span class="bp6-text-muted lx-small">@string.Format(CultureInfo.CurrentCulture, L["UpdatedByAt"], view.UpdatedBy ?? "—", Fmt.DateTime(at))</span>
                }
            </div>
        </EditForm>
    </Section>
}

@code {
    private CompanyProfileView? view;
    private CompanyProfile model = new();
    private ServerErrors? serverErrors;
    private string? error;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        view = await Company.GetCompanyAsync(refresh: true);
        model = view.Profile.Clone();
    }

    private async Task SaveAsync()
    {
        if (view is null)
        {
            return;
        }

        error = null;
        saving = true;
        try
        {
            view = await Company.SaveCompanyAsync(model, view.Version);
            model = view.Profile.Clone();
            Toaster.Success(L["Company_Saved"]);
        }
        catch (ApiException ex)
        {
            error = serverErrors?.Show(ex) ?? ex.UserMessage;
        }
        finally
        {
            saving = false;
        }
    }
}
