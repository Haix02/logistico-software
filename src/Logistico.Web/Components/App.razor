@using System.Globalization
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Logistico.Web.Infrastructure
@inject IStringLocalizer<ServerText> T
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(Rtl ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ecebea" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content="@T["SeoDescription"]" />
    <meta name="application-name" content="Logistico" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="@CanonicalUrl" />
    <meta property="og:title" content="@T["SeoTitle"]" />
    <meta property="og:description" content="@T["SeoDescription"]" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:locale" content="@(Rtl ? "ar_IQ" : "en_US")" />
    <meta property="og:locale:alternate" content="@(Rtl ? "en_US" : "ar_IQ")" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@T["SeoTitle"]" />
    <meta name="twitter:description" content="@T["SeoDescription"]" />
    <base href="/" />
    <title>@T["SeoTitle"]</title>
    @((MarkupString)StructuredData)
    <ResourcePreloader />
    <link rel="preload" href="@Assets["lib/almarai/almarai-arabic-400.woff2"]" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["lib/almarai/almarai.css"]" />
    @* Arabic pages use Blueprint's mirrored build (generated by scripts/vendor-ui-assets.sh with RTLCSS). *@
    <link rel="stylesheet" href="@Assets[Rtl ? "lib/blueprint/blueprint.rtl.css" : "lib/blueprint/blueprint.css"]" />
    <link rel="stylesheet" href="@Assets[Rtl ? "lib/blueprint/blueprint-select.rtl.css" : "lib/blueprint/blueprint-select.css"]" />
    <link rel="stylesheet" href="@Assets["lib/blueprint/blueprint-icons.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @if (IsAccountPage)
    {
        <link rel="stylesheet" href="@Assets["account.css"]" />
    }
    <ImportMap nonce="@HttpContext.CspNonce()" />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* Installable on a phone's home screen (the courier app, the hub station). *@
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Logistico" />
    <script src="@Assets["js/lx.js"]"></script>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <script nonce="@HttpContext.CspNonce()">lx.applyTheme();</script>
    @if (!IsAccountPage)
    {
        <div class="lx-boot-splash" aria-hidden="true">
            <span class="lx-logo lx-logo-large"></span>
            <div class="bp6-spinner bp6-intent-primary">
                <div class="bp6-spinner-animation">
                    <svg width="40" height="40" stroke-width="6.00" viewBox="2.00 2.00 96.00 96.00">
                        <path class="bp6-spinner-track" d="M 50,50 m 0,-45 a 45,45 0 1 1 0,90 a 45,45 0 1 1 0,-90"></path>
                        <path class="bp6-spinner-head" d="M 50,50 m 0,-45 a 45,45 0 1 1 0,90 a 45,45 0 1 1 0,-90" pathLength="280" stroke-dasharray="280 280" stroke-dashoffset="210"></path>
                    </svg>
                </div>
            </div>
        </div>
    }
    <Routes @rendermode="PageRenderMode" />
    @if (!IsAccountPage)
    {
        <script src="@Assets["_framework/blazor.web.js"]"></script>
    }
    @if (IsAccountPage)
    {
        <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    }
</body>

</html>

@code {
    // The app runs entirely in the browser (WebAssembly) and talks to the REST API.
    // Prerendering is off so components never execute on the server.
    private static readonly IComponentRenderMode ClientOnly = new InteractiveWebAssemblyRenderMode(prerender: false);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private static bool Rtl => CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;

    // Account pages (login, register, 2FA…) opt out and render statically on the server.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? ClientOnly : null;

    private bool IsAccountPage => HttpContext.Request.Path.StartsWithSegments("/Account");

    // Crawlers and link previews read this shell; the WebAssembly UI replaces the title per page after it loads.
    private string CanonicalUrl =>
        $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}{HttpContext.Request.PathBase}{HttpContext.Request.Path}";

    // Written as raw markup so the script type stays "application/ld+json" (Razor would encode the plus sign).
    private string StructuredData =>
        $"<script type=\"application/ld+json\" nonce=\"{HttpContext.CspNonce()}\">{JsonLd}</script>";

    private string JsonLd => JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "SoftwareApplication",
        ["name"] = "Logistico",
        ["applicationCategory"] = "BusinessApplication",
        ["operatingSystem"] = "Web",
        ["description"] = T["SeoDescription"].Value,
        ["inLanguage"] = new[] { "ar", "en" },
        ["codeRepository"] = "https://github.com/Haix02/logistico-software",
        ["license"] = "https://www.apache.org/licenses/LICENSE-2.0.html",
        ["offers"] = new Dictionary<string, string>
        {
            ["@type"] = "Offer",
            ["price"] = "0",
            ["priceCurrency"] = "USD",
        },
    });
}
