@using System.Globalization
@using Logistico.Web.Infrastructure
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(Rtl ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111418" />
    <meta name="color-scheme" content="dark light" />
    <base href="/" />
    <title>Logistico</title>
    <ResourcePreloader />
    <link rel="preload" href="@Assets["lib/almarai/almarai-arabic-400.woff2"]" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["lib/almarai/almarai.css"]" />
    @* Arabic pages use Blueprint's mirrored build (generated by scripts/vendor-ui-assets.sh with RTLCSS). *@
    <link rel="stylesheet" href="@Assets[Rtl ? "lib/blueprint/blueprint.rtl.css" : "lib/blueprint/blueprint.css"]" />
    <link rel="stylesheet" href="@Assets[Rtl ? "lib/blueprint/blueprint-select.rtl.css" : "lib/blueprint/blueprint-select.css"]" />
    <link rel="stylesheet" href="@Assets["lib/blueprint/blueprint-icons.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @if (IsAccountPage)
    {
        <link rel="stylesheet" href="@Assets["account.css"]" />
    }
    <ImportMap nonce="@HttpContext.CspNonce()" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script src="@Assets["js/lx.js"]"></script>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <script nonce="@HttpContext.CspNonce()">lx.applyTheme();</script>
    @if (!IsAccountPage)
    {
        <div class="lx-boot-splash" aria-hidden="true">
            <span class="lx-logo lx-logo-large"></span>
            <div class="bp6-spinner bp6-intent-primary">
                <div class="bp6-spinner-animation">
                    <svg width="40" height="40" stroke-width="6.00" viewBox="2.00 2.00 96.00 96.00">
                        <path class="bp6-spinner-track" d="M 50,50 m 0,-45 a 45,45 0 1 1 0,90 a 45,45 0 1 1 0,-90"></path>
                        <path class="bp6-spinner-head" d="M 50,50 m 0,-45 a 45,45 0 1 1 0,90 a 45,45 0 1 1 0,-90" pathLength="280" stroke-dasharray="280 280" stroke-dashoffset="210"></path>
                    </svg>
                </div>
            </div>
        </div>
    }
    <Routes @rendermode="PageRenderMode" />
    @if (!IsAccountPage)
    {
        <script src="@Assets["_framework/blazor.web.js"]"></script>
    }
    @if (IsAccountPage)
    {
        <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    }
</body>

</html>

@code {
    // The app runs entirely in the browser (WebAssembly) and talks to the REST API.
    // Prerendering is off so components never execute on the server.
    private static readonly IComponentRenderMode ClientOnly = new InteractiveWebAssemblyRenderMode(prerender: false);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private static bool Rtl => CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;

    // Account pages (login, register, 2FA…) opt out and render statically on the server.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? ClientOnly : null;

    private bool IsAccountPage => HttpContext.Request.Path.StartsWithSegments("/Account");
}
